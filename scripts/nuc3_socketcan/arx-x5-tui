#!/bin/sh
set -eu

mkdir -p /home/intuition-nuc3/.cache/arx-x5-control
exec 9>/home/intuition-nuc3/.cache/arx-x5-control/tui.lock
if ! flock -n 9; then
    echo '机械臂控制台正在运行。' >&2
    exit 1
fi
sudo -n systemctl start arx-x5-slcan@0.service arx-x5-slcan@1.service
exec /home/intuition-nuc3/arx-connectivity-check/.venv/bin/arx-x5-tui \
    --interface socketcan --channel arxcan0 --channel arxcan1 "$@"
